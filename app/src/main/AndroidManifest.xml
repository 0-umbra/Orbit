<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        ORBIT deliberately requests no permissions in Phase 0: the foundation is
        fully offline and needs no network, location, storage or notification access.
        The merged manifest will still contain the app-private signature permission that
        androidx.core generates for dynamically registered receivers
        (DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION); CI asserts no system permission is
        ever added.
    -->

    <application
        android:name=".OrbitApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Orbit"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
