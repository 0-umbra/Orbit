<?xml version="1.0" encoding="utf-8"?>
<!--
    Benchmark-variant manifest overlay.

    Only the release-equivalent `benchmark` build type merges this file. `profileable`
    (API 29+) lets performance tools such as Perfetto / simpleperf and the measure script in
    tools/perf capture traces from a non-debuggable, R8-optimised build without making the
    shipped release debuggable.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />
    </application>

</manifest>
